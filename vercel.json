{
  "redirects": [
    {
      "source": "/about/alyssa-pataki",
      "destination": "https://www.beyondeatingrecovery.com/about",
      "permanent": true
    },
    {
      "source": "/conditions/eating-disorders-men",
      "destination": "https://www.beyondeatingrecovery.com/conditions/men-eating-disorders",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "beyondeatingrecovery.com" }],
      "destination": "https://www.beyondeatingrecovery.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api|assets|.*\\.xml|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/:path*\\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
